<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="nuqtapass_loyalty_pos.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <!-- 19.0: SelectPartnerButton carries its own t-if (not in the "more" popup), so this button does too. -->
            <button t-if="!props.showRemainingButtons"
                    class="btn btn-secondary btn-lg lh-lg text-truncate o_nuqtapass_button"
                    t-on-click="() => this.onClickNuqtaPass()">NuqtaPass</button>
        </xpath>
    </t>
</templates>
