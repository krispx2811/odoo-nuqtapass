<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="nuqtapass_loyalty_pos.NuqtaPassDialog">
        <Dialog title="this.title" size="'md'">
            <div class="o_nuqtapass_dialog">
                <form t-if="!this.qrOnly" class="d-flex gap-2 mb-3" t-on-submit.prevent="() => this.lookUp()">
                    <label class="visually-hidden" for="o_nuqtapass_query">Phone or scan card</label>
                    <!-- dir=ltr: phones and card ids read left to right in the Arabic till too. -->
                    <input id="o_nuqtapass_query" t-ref="this.inputRef" type="text" inputmode="tel" dir="ltr"
                           class="form-control form-control-lg o_nuqtapass_query" t-model.proxy="this.state.query"
                           placeholder="Phone or scan card" autocomplete="off" spellcheck="false"/>
                    <button type="submit" class="btn btn-primary btn-lg text-nowrap px-4"
                            t-att-disabled="this.state.loading or !this.state.query.trim()">Find</button>
                </form>
                <div t-if="this.state.loading" class="text-muted mb-2" role="status">Loading…</div>
                <!-- <bdi>: a NuqtaPass answer can be English inside the Arabic till; isolate it so its words and dot keep their order. -->
                <div t-if="this.state.error" class="alert alert-warning" role="alert" t-att-title="this.state.errorDetail or undefined"><bdi t-out="this.state.error"/></div>
                <div t-if="this.state.done" class="alert alert-success" role="status"><bdi t-out="this.state.done"/></div>
                <t t-if="this.state.result">
                    <div class="o_nuqtapass_who fs-4 fw-bold mb-1"><bdi dir="ltr" t-out="this.phoneText"/></div>
                    <div t-if="this.tier" class="o_nuqtapass_tier d-flex flex-wrap align-items-center column-gap-2 mb-2">
                        <span class="o_nuqtapass_tier_dot" t-att-style="this.tier.color ? 'background-color: ' + this.tier.color : ''" aria-hidden="true"/>
                        <span class="fw-semibold"><bdi t-out="this.tier.member"/></span>
                        <span t-if="this.tier.next" class="text-muted"><bdi t-out="this.tier.next"/></span>
                    </div>
                    <p t-if="!this.state.result.cards.length" class="text-muted mb-2">
                        No card yet. The customer gets one with their first purchase.
                    </p>
                    <div t-foreach="this.state.result.cards" t-as="card" t-key="card.cardId"
                         class="o_nuqtapass_card d-flex flex-wrap align-items-center gap-2 py-2 px-3 mb-2 rounded"
                         t-att-style="this.bandStyle(card)">
                        <div class="flex-grow-1">
                            <!-- <bdi>: the shop's own voucher title and the numbers in the line keep their order in RTL. -->
                            <div class="o_nuqtapass_card_title small text-muted"><bdi t-out="this.cardTitle(card)"/></div>
                            <div class="o_nuqtapass_card_line fs-5 fw-semibold"><bdi t-out="this.cardLine(card)"/></div>
                        </div>
                        <t t-if="!this.order">
                            <button t-if="card.type === 'STAMPS' and card.rewardReady" class="btn btn-primary btn-lg"
                                    t-att-disabled="this.state.loading"
                                    t-on-click="() => this.redeem(card, 'reward')">Give reward</button>
                            <button t-if="card.type === 'VOUCHER' and card.voucher and card.voucher.usesLeft > 0"
                                    class="btn btn-primary btn-lg" t-att-disabled="this.state.loading"
                                    t-on-click="() => this.redeem(card, 'voucher')">Use voucher</button>
                        </t>
                        <button t-if="this.canCorrect(card) and this.state.correcting !== card.cardId" type="button"
                                class="btn btn-link btn-sm p-0 o_nuqtapass_correct_link"
                                t-on-click="() => this.startCorrect(card)">Correct</button>
                        <div t-if="this.state.correcting === card.cardId" class="w-100">
                            <NuqtaPassCorrectBox card="card" busy="this.state.loading"
                                                 onSave="(body) => this.saveCorrection(body)"
                                                 onCancel="() => (this.state.correcting = '')"/>
                        </div>
                        <div t-if="this.canUsePoints(card)" class="w-100">
                            <NuqtaPassPointsBox card="card" currency="this.state.result.currency"
                                                cap="this.state.result.limits and this.state.result.limits.pointsPerVisit"
                                                maxValue="this.maxPointsValue" busy="this.state.loading"
                                                onUse="(plan) => this.usePoints(card, plan)"/>
                        </div>
                    </div>
                </t>
                <div t-if="this.state.welcome" class="o_nuqtapass_qr text-center mt-3">
                    <img t-att-src="this.state.welcome.qr" width="200" height="200" alt="QR code of the card"/>
                    <p class="fs-5 fw-bold mt-2 mb-2">Scan to add your card</p>
                    <div t-if="this.state.welcome.whatsapp or this.state.welcome.sms"
                         class="d-flex justify-content-center flex-wrap gap-2">
                        <a t-if="this.state.welcome.whatsapp" class="btn btn-secondary"
                           t-att-href="this.state.welcome.whatsapp" target="_blank" rel="noopener noreferrer">Send by WhatsApp</a>
                        <a t-if="this.state.welcome.sms" class="btn btn-secondary"
                           t-att-href="this.state.welcome.sms">Send by SMS</a>
                    </div>
                </div>
                <p t-if="this.atPaymentHint" class="o_nuqtapass_hint text-muted mt-2 mb-0">
                    Use credit, packs, rewards and vouchers on the payment screen.
                </p>
                <p t-if="this.willEarn" class="o_nuqtapass_will_earn text-success fw-medium mt-3 mb-0" role="status">
                    <span aria-hidden="true">✓ </span><bdi t-out="this.willEarn"/>
                </p>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary btn-lg" t-on-click="() => this.props.close()">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
