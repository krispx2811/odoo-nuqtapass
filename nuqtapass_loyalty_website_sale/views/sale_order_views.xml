<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_nuqtapass" model="ir.ui.view">
        <field name="name">sale.order.form.nuqtapass</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="after">
                <page name="nuqtapass" string="NuqtaPass" invisible="not nuqtapass_sync_ids">
                    <field name="nuqtapass_sync_ids" readonly="1">
                        <list>
                            <field name="kind"/>
                            <field name="refund_ref"/>
                            <field name="phone" widget="phone"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                            <field name="summary"/>
                            <button name="action_resend" type="object" string="Resend" icon="fa-repeat" invisible="state == 'done'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_nuqtapass_sync_website" name="NuqtaPass sync" parent="website_sale.menu_orders"
              action="nuqtapass_loyalty.action_nuqtapass_sync" sequence="90"
              groups="sales_team.group_sale_manager"/>
</odoo>
